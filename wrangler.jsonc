{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trading-journal-ai",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trading-journal-db",
      "database_id": "d1-trading-journal-prod-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_STORAGE",
      "bucket_name": "trading-journal-screenshots"
    }
  ]
}
